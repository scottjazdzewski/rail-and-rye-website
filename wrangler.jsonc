{
  "name": "rail-and-rye-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin*",
      "/api/*",
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CARDS_BUCKET",
      "bucket_name": "rail-and-rye-private-cards"
    }
  ],
  "d1_databases": [
    {
      "binding": "STORE_DB",
      "database_name": "rail-and-rye-store",
      "database_id": "9109de34-c3f1-4482-af87-02c3461b84f1"
    }
  ],
  "keep_vars": true
}
