# Speed up returning visitors without caching payment or private responses.
# Cloudflare Workers Static Assets honors these headers for public files only.
/assets/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/favicon.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/membership/account/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/membership/success.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# Data-display code must be revalidated on navigation, not cached for a day.
# Canonical reader shells also carry a release-specific version query.
